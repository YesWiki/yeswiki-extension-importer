<h1>{{ _t('Admin des importers') }}</h1>

{% if message is not null %}
<div class="alert alert-success">{{ message }}</div>
{% endif %}

{% if dataSources is not empty %}
<table class="table">
  <thead>
    <tr>
      <th>{{ _t('IMPORTER_SOURCE_TYPE') }}</th>
      <th>{{ _t('IMPORTER_SOURCE_URL') }}</th>
      <th>{{ _t('IMPORTER_LAST_AUTO_SYNC') }}</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    {% for id,source in dataSources %}
    <tr>
      <td>{{ _t('IMPORTER_' ~ (source.importer|default(''))|upper) }}</td>
      <td>{{ source.url|default('') }}</td>
      <td>
        {% if not autoSync[id].enabled %}
        {{ _t('IMPORTER_AUTO_SYNC_DISABLED') }}
        {% elseif autoSync[id].last is null %}
        {{ _t('IMPORTER_AUTO_SYNC_NEVER') }}
        {% else %}
        <a href="#" class="importer-auto-sync-log" data-id="{{ id }}">{{ autoSync[id].last.time|date('d/m/Y H:i') }}</a>
        {% endif %}
      </td>
      <td>
        <form method="POST" action="{{currentUrl}}" style="display:inline">
          <input type="hidden" name="syncSource" value="{{ id }}">
          <button class="btn btn-default btn-xs" type="submit" title="{{ _t('IMPORTER_SYNC_RUN') }}" data-toggle="tooltip" data-placement="bottom">
            <i class="fas fa-sync"></i>
          </button>
        </form>
        <button type="button" class="btn btn-default btn-xs importer-edit-btn" data-id="{{ id }}" title="{{ _t('BAZ_MODIFIER') }}" data-toggle="tooltip" data-placement="bottom">
          <i class="fa fa-pencil-alt"></i>
        </button>
        <form method="POST" action="{{currentUrl}}" style="display:inline">
          <input type="hidden" name="delete" value="{{ id }}">
          <button class="btn btn-danger btn-xs" type="submit" onclick="return confirm('{{ _t('IMPORTER_CONFIRM_DELETE')|e('js') }}')" title="{{ _t('BAZ_SUPPRIMER') }}" data-toggle="tooltip" data-placement="bottom">
            <i class="fa fa-trash"></i>
          </button>
        </form>
      </td>
    </tr>
    {% if syncedSourceId == id %}
    <tr>
      <td colspan="4"><pre>{{ syncOutput }}</pre></td>
    </tr>
    {% endif %}
    {% if autoSync[id].enabled and autoSync[id].last is not null %}
    <tr class="importer-auto-sync-log-row hide" data-id="{{ id }}">
      <td colspan="4"><pre>{{ autoSync[id].last.output }}</pre></td>
    </tr>
    {% endif %}
    {% endfor %}
  </tbody>
</table>
{% endif %}

<h2 id="importer-form-title">{{ _t('IMPORTER_ADD_SOURCE') }}</h2>
<form method="POST" action="{{currentUrl}}" id="importer-form">
  <input type="hidden" id="id" name="id">
  <div class="form-group">
    <div class="bazar-radio-rows bazar-radio radio_required">
    {% for name,class in importers %}
    <div class="radio">
      <label>
        <input type="radio" name="importer" id="importer_{{name}}" value="{{name}}" class="importer-radio">
        <span>{{ _t('IMPORTER_' ~ name|upper) }}</span>
      </label>
    </div>
    {% endfor %}
    </div>
  </div>

  {% for name,fields in importerFields %}
  <div id="form_{{name}}" class="importer-form hide">
    {% for key,field in fields %}
    {% set fieldLabel = _t(field.label|default('IMPORTER_FIELD_' ~ key|upper)) %}
    <div class="form-group">
      {% if field.type == 'checkbox' %}
      <div class="checkbox">
        <label>
          <input type="checkbox" name="{{key}}{{name}}" id="{{key}}{{name}}" value="1"> {{ fieldLabel }}
        </label>
      </div>
      {% elseif field.type == 'select' %}
      <label for="{{key}}{{name}}" class="control-label">{{ fieldLabel }}</label>
      <select class="form-control{{ field.required ? ' conditional-required' : '' }}" name="{{key}}{{name}}" id="{{key}}{{name}}">
        {% for optValue,optLabelKey in field.options %}
        <option value="{{optValue}}">{{ _t(optLabelKey) }}</option>
        {% endfor %}
      </select>
      {% else %}
      <label for="{{key}}{{name}}" class="control-label">{{ fieldLabel }}</label>
      <input type="{{field.type}}" class="form-control{{ field.required ? ' conditional-required' : '' }}" name="{{key}}{{name}}" id="{{key}}{{name}}" placeholder="{{ fieldLabel }}">
      {% endif %}
      {% if field.help is defined %}
      <span class="help-block">{{ _t(field.help) }}</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  <div id="form_group_formId" class="form-group hide">
    <label for="formId" class="control-label">{{ _t('IMPORTER_BAZAR_ID') }}</label>
    <div class="">
      <select required class="form-control" id="formId" name="formId">
        <option value="new">{{ _t('IMPORTER_FORM_NEW') }}</option>
        {% for formId,form in forms %}
        <option value="{{ formId }}">{{ form.bn_label_nature|default(formId) }} ({{ formId }})</option>
        {% endfor %}
      </select>
    </div>
  </div>
  <div id="field-mapping-container"></div>

  <button class="btn btn-primary" type="submit">{{ _t('BAZ_SAVE')}}</button>
  <button class="btn btn-default hide" type="button" id="importer-cancel-edit">{{ _t('IMPORTER_CANCEL_EDIT')}}</button>
</form>
<script>
document.addEventListener("DOMContentLoaded", function() {
  // importers that do not create Bazar entries, so no formId is needed
  const importersWithoutForm = {{ importersWithoutForm|json_encode|raw }}
  const importerFields = {{ importerFields|json_encode|raw }}
  const dataSources = {{ dataSourcesJson|raw }}
  // importer(s) that can offer a field-mapping table when an existing form is picked
  // (either a fixed own field list, or a remote form fetched at map_fields step time)
  const importersWithFieldMapping = {{ importersWithFieldMapping|json_encode|raw }}

  function showImporterForm(name) {
    // a hidden field cannot be a required field (browser can't focus it to show the validation error)
    $('.importer-form').addClass('hide').find('.conditional-required').prop('required', false)
    $('#form_'+name).removeClass('hide').find('.conditional-required').prop('required', true)
    const needsForm = !importersWithoutForm.includes(name)
    $('#form_group_formId').toggleClass('hide', !needsForm)
    $('#formId').prop('required', needsForm)
  }

  // builds the mapping table from scratch every time (DOM text(), not html(), since remote
  // field labels/keys can come from an arbitrary remote wiki)
  function renderFieldMapping(fieldMapping, preselected) {
    const container = $('#field-mapping-container').empty()
    if (!fieldMapping) {
      return
    }
    preselected = preselected || {}
    const title = $('<h2>').text('{{ _t('IMPORTER_FIELD_MAPPING_TITLE')|e('js') }}')
    const table = $('<table>').addClass('table')
    const headRow = $('<tr>').append(
      $('<th>').text('{{ _t('IMPORTER_FIELD_MAPPING_REMOTE')|e('js') }}'),
      $('<th>').text('{{ _t('IMPORTER_FIELD_MAPPING_LOCAL')|e('js') }}')
    )
    const tbody = $('<tbody>')
    fieldMapping.remote.forEach(function(remoteField) {
      const select = $('<select>').addClass('form-control').attr('name', 'fieldsMapping['+remoteField.key+']')
      const skipOption = $('<option>').val('').text('{{ _t('IMPORTER_FIELD_MAPPING_SKIP')|e('js') }}')
      select.append(skipOption)
      const selectedValue = preselected[remoteField.key] !== undefined ? preselected[remoteField.key] : remoteField.key
      fieldMapping.local.forEach(function(localField) {
        const option = $('<option>').val(localField.key).text(localField.label+' ('+localField.key+')')
        if (localField.key === selectedValue) {
          option.prop('selected', true)
        }
        select.append(option)
      })
      const labelCell = $('<td>').text(remoteField.label+' ')
      labelCell.append($('<code>').text(remoteField.key))
      tbody.append($('<tr>').append(labelCell, $('<td>').append(select)))
    })
    table.append($('<thead>').append(headRow), tbody)
    container.append(title, table)
  }

  // fetches the remote/local field lists for the currently selected importer+formId and
  // (re)builds the mapping table live, instead of requiring a full form submit/reload
  function fetchFieldMapping(preselected) {
    const importer = $('.importer-radio:checked').val()
    const formId = $('#formId').val()
    $('#field-mapping-container').empty()
    if (!importersWithFieldMapping.includes(importer) || !formId || formId === 'new') {
      return
    }
    const formData = new FormData($('#importer-form')[0])
    // an importer fetching its fields from a remote form can only answer once its url and
    // credentials are filled in: stay silent while they aren't, warn once they are
    const hasUrl = !!$('#url'+importer).val()
    fetch('?api/importer/mapping-fields', { method: 'POST', body: formData })
      .then(function(res) { return res.json() })
      .then(function(data) {
        if (data.fieldMapping) {
          renderFieldMapping(data.fieldMapping, preselected)
        } else if (hasUrl) {
          $('#field-mapping-container').append(
            $('<div>').addClass('alert alert-warning').text('{{ _t('IMPORTER_MAPPING_FETCH_FAILED')|e('js') }}')
          )
        }
      })
  }

  $('.importer-radio').on('click', function() {
    showImporterForm($(this).val())
    fetchFieldMapping()
  })

  $('#formId').on('change', function() {
    fetchFieldMapping()
  })

  // the output of the last automatic sync is rendered folded: it's only of interest when
  // something looks wrong with a source nobody is watching
  $('.importer-auto-sync-log').on('click', function(event) {
    event.preventDefault()
    $('.importer-auto-sync-log-row[data-id="'+$(this).data('id')+'"]').toggleClass('hide')
  })

  $('.importer-edit-btn').on('click', function() {
    const id = $(this).data('id')
    const source = dataSources[id]
    if (!source) {
      return
    }
    $('#id').val(id)
    $('#importer_'+source.importer).prop('checked', true)
    showImporterForm(source.importer)
    const fields = importerFields[source.importer] || {}
    Object.keys(fields).forEach(function(key) {
      const field = fields[key]
      const input = $('#'+key+source.importer)
      let value = key.indexOf('auth_') === 0
        ? (source.auth || {})[key.substring(5)]
        : source[key]
      if (field.type === 'checkbox') {
        input.prop('checked', !!value)
      } else if (field.type === 'select') {
        // a source saved before this field existed has no value for it: back to its default
        input.val(value || input.find('option').first().val())
      } else {
        input.val(value || '')
      }
    })
    $('#formId').val(source.formId || 'new')
    $('#importer-form-title').text('{{ _t('IMPORTER_EDIT_SOURCE')|e('js') }}')
    $('#importer-cancel-edit').removeClass('hide')
    fetchFieldMapping(source.fieldsMapping || {})
    $('html, body').animate({ scrollTop: $('#importer-form').offset().top }, 200)
  })

  $('#importer-cancel-edit').on('click', function() {
    $('#importer-form')[0].reset()
    $('#id').val('')
    $('.importer-form').addClass('hide').find('.conditional-required').prop('required', false)
    $('#form_group_formId').addClass('hide')
    $('#formId').prop('required', false)
    $('#field-mapping-container').empty()
    $('#importer-form-title').text('{{ _t('IMPORTER_ADD_SOURCE')|e('js') }}')
    $(this).addClass('hide')
  })
})
</script>
